{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Trae Work 助手",
  "identifier": "com.traework.assistant",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev:vite",
    "beforeBuildCommand": "python3 scripts/prepare_python_runtime_macos.py && npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Trae Work 助手",
        "width": 1180,
        "height": 760,
        "minWidth": 960,
        "minHeight": 600,
        "decorations": false,
        "resizable": true,
        "center": true,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.icns", "icons/icon.ico"],
    "resources": {
      "../build/python-bundle/": "python/",
      "../src-ps/": "ps/"
    },
    "shortDescription": "Trae Work 多账号签到与管理助手",
    "longDescription": "整合多账号签到、登录态切换、设备隔离与账号分组的桌面端工具（macOS 版）。",
    "publisher": "Trae Work 助手",
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "windows": {
      "nsis": {
        "template": "windows/installer.nsi",
        "displayLanguageSelector": false,
        "languages": ["SimpChinese"]
      },
      "wix": {
        "language": "zh-CN"
      }
    }
  },
  "plugins": {}
}
